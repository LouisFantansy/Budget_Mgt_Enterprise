# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=budget_user
DB_PASSWORD=budget_pass
DB_DATABASE=budget_db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 应用配置
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# 预算配置
BUDGET_ALERT_THRESHOLD_YELLOW=80
BUDGET_ALERT_THRESHOLD_ORANGE=90
BUDGET_ALERT_THRESHOLD_RED=100
